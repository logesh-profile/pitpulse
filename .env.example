# ==============================================================================
# PitPulse Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL CONFIGURATION VALUES.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Backend Server Configuration
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
DEBUG=true

# Security & JWT Credentials
# Generate secure keys via: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_USER=pitpulse_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pitpulse_db
DATABASE_URL=postgresql+asyncpg://pitpulse_user:your_secure_db_password@localhost:5432/pitpulse_db

# S3-Compatible Object Storage (MinIO / AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=pitpulse-records
S3_REGION=us-east-1
S3_USE_SSL=false

# AI Services Configuration
AI_SERVICE_ENABLED=true
AI_MODEL_NAME=risk-screening-v1
AI_CONFIDENCE_THRESHOLD=0.75

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
