# PitPulse FastAPI Backend Environment Configuration
APP_NAME=pitpulse-api
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=*

# Security Configuration (Placeholders - No production secrets here)
JWT_SECRET_KEY=your-32-character-secret-key-placeholder
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Database Connection (Placeholder for Stage 2+)
DATABASE_URL=postgresql+asyncpg://pitpulse_user:placeholder_password@localhost:5432/pitpulse_db
